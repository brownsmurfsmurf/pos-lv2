# このファイルを .env という名前でコピーして、値を入れてください。.env は Git に入りません。

# development | production
APP_ENV=development

# ---- データベース ----
# 手元で試すだけなら、下の 6 行は空のままで構いません（SQLite の pos.db を使います）。
# Azure Database for MySQL につなぐときは、6 つすべてを設定します（講座の教材と同じ名前）。
#
# パスワードは「そのまま」書いてください。@ や & が入っていても、変換は不要です。
# プログラム側（app/db.py の build_database_url）が安全な形に変換します。
# 値の前後に空白を入れない。# を含む場合だけ、全体を "..." で囲む。
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_NAME=
# 証明書ファイル（.pem）の場所。空なら OS が持つ証明書で検証します
SSL_CA_PATH=

# DB_HOST が空のときに使う接続先
DATABASE_URL=sqlite:///./pos.db

# ---- そのほか ----
# 32 文字以上のランダムな文字列
JWT_SECRET=change-me-to-a-long-random-secret-string
# pos-web（Next.js）のオリジン。複数はカンマ区切り
CORS_ALLOW_ORIGINS=http://localhost:3000
