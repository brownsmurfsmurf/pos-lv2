# development | production
APP_ENV=development
# MySQL: mysql+pymysql://user:pass@host:3306/pos?charset=utf8mb4
# ローカル動作確認用に SQLite も可: sqlite:///./pos.db
DATABASE_URL=sqlite:///./pos.db
# 32 文字以上のランダム文字列
JWT_SECRET=change-me-to-a-long-random-secret-string
# BFF（Next.js）のオリジン。複数はカンマ区切り
CORS_ALLOW_ORIGINS=http://localhost:3000
# 任意: shared/limits.json の場所を明示する場合
# LIMITS_PATH=../shared/limits.json
